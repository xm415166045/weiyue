# 依赖
node_modules/

# Expo / Metro 缓存与导出产物
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# 原生工程生成目录
/ios/
/android/

# 如果保留 android 原生工程，仍需忽略构建缓存
android/.gradle/
android/app/build/
android/app/.cxx/
android/build/

# 任意本地原生模块的编译产物（禁止入库）
# 注：曾为 cheat-engine「锁原生模块指纹」把 .dex/.bin force-add 进仓库，
#     现已清理；如需锁指纹请提交 sha 文本文件，不要提交二进制。
**/build/
**/.cxx/
**/.gradle/
**/.transforms/
**/*.dex

# 自定义原生模块源码的唯一真源在 plugins/native/（受版本控制），
# 由 app.plugin.js 在 prebuild 时恢复到被忽略的 android/ 目录。
!plugins/native/

# 构建产物
*.apk
*.aab
*.apks

# 签名与证书
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# 本地环境
.env
.env.*
!.env.example

# 日志
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript
*.tsbuildinfo

# 系统文件
.DS_Store
Thumbs.db

# 临时备份
*.orig.*

# AI 编码助手配置与个人文档（不入库）
.cheat/
.claude/
CLAUDE.md
